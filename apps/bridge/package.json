{
  "name": "agent-remote-cli",
  "version": "0.1.0",
  "description": "Local-first Host Bridge CLI for controlling Antigravity CLI and coding agents smoothly from your phone.",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "agent-remote": "./dist/cli.js",
    "agent-remote-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@agent-remote/protocol": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "antigravity",
    "agy",
    "ai-agents",
    "coding-agent",
    "mobile",
    "remote-control",
    "acp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/letmevibe/agent-remote.git",
    "directory": "apps/bridge"
  },
  "homepage": "https://github.com/letmevibe/agent-remote#readme",
  "license": "MIT"
}
